root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psm1,cmd,bat}]
# PowerShell scripts in this repo must stay ASCII-only (PowerShell 5.1 parses .ps1 as ANSI).
charset = utf-8
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{c,cpp,h,hpp}]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[patches/*.patch]
charset = utf-8
insert_final_newline = true
