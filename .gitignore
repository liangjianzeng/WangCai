# Build outputs
# src/llama/ is the vendored upstream clone, recreated by tools/bootstrap.ps1.
# (gitignore patterns cannot carry inline # comments - keeping it on its own line.)
src/llama/
build/
build-*/
out/
*.obj
*.dll
*.exe
*.lib
*.exp
*.pdb
*.ilk

# src/ggml-openvino/ IS tracked: it is WangCai's own source (the patched OpenVINO backend).

# OpenVINO runtime drop and NPU compiled-graph caches (regenerable, multi-GB)
ov/
*cache*/
*.nv12
*.noh
leif_cache/

# Tensor dumps produced by GGML_OPENVINO_DUMP_BIN and the diagnostic logs around them
dbg/
dumps/
*.bin
!docs/**/*.bin
*.log
cgraph_ov*.txt
IR_*.xml
IR_*.bin

# Model weights — never commit
*.gguf
*.ggml
*.safetensors
# 只锚定仓库根的权重目录。不带前导斜杠会级联误伤 app/lib/models/ ——
# 2026-11-05 发现该源码目录 8 个 dart 文件长期未被跟踪（clone 即缺件）。
/models/

# Python venvs used to unpack the OpenVINO wheel
.venv/
venv/
__pycache__/

# Editors / OS
.vs/
.vscode/
.idea/
*.user
Thumbs.db
.DS_Store

# Agent / assistant project memory — private engineering notes, never committed here
# (see the private docs repo; these must not appear in the public clone)
AGENTS.md
agents.md
**/AGENTS.md
CLAUDE.md
**/CLAUDE.md
.claude/
.workbuddy/
.qoder/

# Local scratch
*.orig
*.rej
tmp/
.envrc.local

# 引擎商店离线包与上传暂存（不入库）
tmp_store/
.zcode-uploads/

# build artifacts — portable zip is 100+ MB, must never enter git (GitHub 100 MB blob limit)
packaging/dist/

# ZCode 会话私有草稿（计划书等，同 .claude/ 一类 agent 记忆）
.zcode/
